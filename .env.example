# Loaded from the directory `dataset-viewer` is launched in (if present).
OPENAI_API_KEY=sk-...      # judges (default presets use OpenAI models)
ANTHROPIC_API_KEY=sk-ant-...  # embedded Claude chat ([chat] extra); a logged-in `claude` CLI also works
# Optional: ":"-separated list of dirs to scan (CLI args take precedence).
# DATASET_VIEWER_SCAN_ROOTS=/abs/path/one:/abs/path/two
# DATASET_VIEWER_HOST=127.0.0.1
# DATASET_VIEWER_PORT=8765
